{
  "name": "@lingo/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "pnpm run build:e2e && playwright test",
    "live:page-translation": "pnpm run build:e2e && node --env-file-if-exists=../../.env.local e2e/page-translation-live.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@lingo/core": "workspace:*",
    "@lingo/providers": "workspace:*",
    "@lingo/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.8",
    "vitest": "catalog:",
    "wxt": "^0.21.5"
  }
}
